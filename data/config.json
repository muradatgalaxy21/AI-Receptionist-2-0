{
  "type": "Settings",
  "audio": {
    "input": { "encoding": "mulaw", "sample_rate": 8000 },
    "output": { "encoding": "mulaw", "sample_rate": 8000, "container": "none" }
  },
  "agent": {
    "listen": {
      "provider": { "type": "deepgram", "model": "nova-2", "endpointing": 300 }
    },
    "think": {
      "provider": { "type": "open_ai", "model": "gpt-4o-mini" },
      "prompt": "You are Sarah, a receptionist. \n\nRULES:\n1. If you hear a Date/Time, CALL 'check_availability'.\n2. IMPORTANT: Pass dates exactly as spoken (e.g. 'tomorrow', 'next tuesday'). Do NOT calculate dates.\n3. CALL 'book_appointment_tool' when you have Name, Reason, Date, and Time.\n4. If the user gives a single name like 'Ahad', pass it. Do not ask for a last name.\n5. Keep answers short.",
      "functions": [
        {
          "name": "check_availability",
          "description": "Check availability.",
          "parameters": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "description": "Spoken date (e.g. 'tomorrow')" },
              "time": { "type": "string", "description": "Spoken time (e.g. '6 PM')" }
            },
            "required": ["date"]
          }
        },
        {
          "name": "book_appointment_tool",
          "description": "Book appointment.",
          "parameters": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "User's name" },
              "reason": { "type": "string" },
              "date": { "type": "string", "description": "Spoken date" },
              "time": { "type": "string" }
            },
            "required": ["name", "reason", "date", "time"]
          }
        }
      ]
    },
    "speak": { "provider": { "type": "deepgram", "model": "aura-asteria-en" } },
    "greeting": "Hello, Dr. Farooq's Dental Clinic. This is Sarah."
  }
}